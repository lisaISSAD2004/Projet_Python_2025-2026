                                 height=60, corner_radius=5)
        item_frame.pack(fill="x", pady=2, padx=5)
        item_frame.pack_propagate(False)  # Empêche le frame de rétrécir
        
        # Icône avec extension
        extension = "MP3" if metadata.file_path.lower().endswith(".mp3") else "FLAC"
        icon = "🎵" if extension == "MP3" else "🎼"
        icon_label = ctk.CTkLabel(item_frame, text=icon, width=30)
        icon_label.pack(side="left", padx=5)
        
        # Info Text
        text_frame = ctk.CTkFrame(item_frame, fg_color="transparent")
        text_frame.pack(side="left", fill="both", expand=True, padx=5)
        
        title = metadata.title if metadata.title else metadata.file_name
        artist = metadata.artist if metadata.artist else "Artiste inconnu"
        
        # Titre avec extension
        title_with_ext = f"{title} ({extension})"
        title_label = ctk.CTkLabel(text_frame, text=title_with_ext, anchor="w", 
                                   font=ctk.CTkFont(weight="bold", size=12))
        title_label.pack(fill="x", anchor="w")
        
        artist_label = ctk.CTkLabel(text_frame, text=artist, anchor="w", 
                                    text_color="gray", font=ctk.CTkFont(size=10))
        artist_label.pack(fill="x", anchor="w")
        
        # Bouton pour ajouter à la playlist
        btn_add = ctk.CTkButton(item_frame, text="+", width=30, height=30,
                               fg_color="transparent", hover_color="#1f6aa5",
                               command=lambda m=metadata: self.add_to_playlist(m))
        btn_add.pack(side="right", padx=5)
        
        # Rendre l'item cliquable pour afficher les métadonnées
        for widget in [item_frame, icon_label, text_frame, title_label, artist_label]:
            widget.bind("<Button-1>", lambda e, m=metadata: self.display_metadata(m))
            widget.configure(cursor="hand2")  # Curseur main
        
        # Stocker la référence
        self.file_items[metadata.file_path] = item_frame

    def filter_files(self, event=None):
        """Filtre les fichiers selon le texte de recherche"""
        search_text = self.search_entry.get().lower()
        
        if not self.current_directory:
            return
            
        # Détruire tous les items existants
        for widget in self.file_scroll.winfo_children():
            widget.destroy()
        self.file_items.clear()
        
        # Recréer les items filtrés
        for metadata in self.current_directory.files:
            title = (metadata.title or metadata.file_name).lower()
            artist = (metadata.artist or "").lower()
            
            if search_text in title or search_text in artist:
                self.create_file_item(metadata)

