    def open_directory(self):
        """Ouvre un dossier et explore les fichiers audio"""
        directory_path = filedialog.askdirectory(title="Sélectionner un dossier")
        
        if not directory_path:
            return
        
        # Vérifier que le dossier existe
        if not os.path.isdir(directory_path):
            messagebox.showerror("Erreur", "Le dossier n'existe pas")
            return
        
        # Mettre à jour le footer
        self.footer_label.configure(text="Exploration en cours...")
        
        # Forcer la mise à jour de l'interface
        self.update_idletasks()
        self.update()
        
        # Créer l'objet Directory
        self.current_directory = Directory(directory_path)
        
        # Explorer directement
        self.current_directory.exploration_dir()
        
        # Mettre à jour l'interface directement
        self.update_file_list()

    def update_file_list(self):
        """Met à jour la liste des fichiers"""
        if not self.current_directory:
            return
        
        # Effacer la liste actuelle
        for widget in self.file_scroll.winfo_children():
            widget.destroy()
        self.file_items.clear()
        
        # Ajouter les nouveaux fichiers
        for metadata in self.current_directory.files:
            self.create_file_item(metadata)
        
        # CRUCIAL: Forcer le rafraîchissement complet
        self.file_scroll.update()
        self.file_scroll._parent_canvas.update_idletasks()
        self.update()
        
        # Mettre à jour le footer
        count = len(self.current_directory.files)
        self.footer_label.configure(text=f"Prêt | {count} fichiers trouvés")
        
        if count == 0:
            # Afficher un message si aucun fichier trouvé
            empty_label = ctk.CTkLabel(self.file_scroll, 
                                      text="Aucun fichier MP3/FLAC trouvé dans ce dossier",
                                      text_color="gray")
            empty_label.pack(pady=20)

    def display_metadata(self, metadata: Metadata):
        """Affiche les métadonnées d'un fichier sélectionné"""
        self.selected_file = metadata
        
        # Masquer le placeholder, afficher le contenu
        self.meta_placeholder.pack_forget()
        self.meta_content.pack(fill="both", expand=True)
        
        # Remplir les champs
        self.title_entry.delete(0, "end")
        self.title_entry.insert(0, metadata.title or "")
        
        self.artist_entry.delete(0, "end")
        self.artist_entry.insert(0, metadata.artist or "")
        
        self.album_entry.delete(0, "end")
        self.album_entry.insert(0, metadata.album or "")
        
        self.year_entry.delete(0, "end")
        self.year_entry.insert(0, metadata.year or "")
        
        self.genre_entry.delete(0, "end")
        
        # TODO: Afficher la durée si disponible
        self.duration_label.configure(text="--:--")
        
        # Switch vers l'onglet métadonnées
        self.tab_view.set("Métadonnées")

    def save_metadata(self):
        """Sauvegarde les modifications des métadonnées"""
        if not self.selected_file:
            return
        
        # Récupérer les nouvelles valeurs
        new_tags = {
            "title": self.title_entry.get(),
            "artist": self.artist_entry.get(),
            "album": self.album_entry.get(),
            "year": self.year_entry.get()
        }
        
        try:
            # Créer l'objet audio approprié
            if self.selected_file.file_path.lower().endswith(".mp3"):
                audio = Mp3File(self.selected_file.file_path)
            else:
                audio = FlacFile(self.selected_file.file_path)
            
            # Sauvegarder
            audio.save_tags(**new_tags)
            
            # Mettre à jour l'objet metadata
            self.selected_file.extract_tags()
            
            messagebox.showinfo("Succès", "Métadonnées sauvegardées avec succès")
            
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible de sauvegarder: {e}")

    def play_selected_file(self):
        """Joue le fichier sélectionné"""
        if not self.selected_file:
            messagebox.showinfo("Info", "Aucun fichier sélectionné")
            return
        
        # Si déjà en lecture, arrêter d'abord
        if self.is_playing and self.current_audio:
            self.stop_playback()
            return
        
        try:
            # Créer l'objet audio approprié
            if self.selected_file.file_path.lower().endswith(".mp3"):
                self.current_audio = Mp3File(self.selected_file.file_path)
            else:
                self.current_audio = FlacFile(self.selected_file.file_path)
            
            self.is_playing = True
            self.btn_play_file.configure(text="⏹ Arrêter", fg_color="#C62828")
            
            # Lecture en thread pour ne pas bloquer
            def play():
                try:
                    self.current_audio.play()
                except Exception as e:
                    print(f"Erreur de lecture: {e}")
                finally:
                    self.is_playing = False
                    self.after(0, lambda: self.btn_play_file.configure(
                        text="▷ Lire le Morceau", fg_color="#2196F3"))
            
            threading.Thread(target=play, daemon=True).start()
            
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible de lire le fichier: {e}")
            self.is_playing = False
    
    def stop_playback(self):
        """Arrête la lecture en cours"""
        if self.current_audio:
            try:
                self.current_audio.stop()
            except:
                pass
        self.is_playing = False
        self.btn_play_file.configure(text="▷ Lire le Morceau", fg_color="#2196F3")

    def add_to_playlist(self, metadata: Metadata):
        """Ajoute un fichier à la playlist"""
        if metadata not in self.playlist:
            self.playlist.append(metadata)
            self.update_playlist_display()

    def update_playlist_display(self):
        """Met à jour l'affichage de la playlist"""
        # Masquer/afficher le message vide
        if self.playlist:
            self.playlist_empty.grid_forget()
            self.playlist_scroll.grid(row=1, column=0, sticky="nsew", padx=10)
        else:
            self.playlist_scroll.grid_forget()
            self.playlist_empty.grid(row=1, column=0)
        
        # Vider et reconstruire la playlist
        for widget in self.playlist_scroll.winfo_children():
            widget.destroy()
        
        for idx, meta in enumerate(self.playlist):
            self.create_playlist_item(meta, idx)
        
        # Mettre à jour le compteur
        self.playlist_count_label.configure(text=f"{len(self.playlist)} morceaux")

    def create_playlist_item(self, metadata: Metadata, index: int):
        """Crée un item dans la playlist"""
        item = ctk.CTkFrame(self.playlist_scroll, fg_color=("#3b3b3b", "#2b2b2b"))
        item.pack(fill="x", pady=2)
        
        # Numéro
        ctk.CTkLabel(item, text=f"{index+1}.", width=30).pack(side="left", padx=5)
        
        # Info
        info = ctk.CTkFrame(item, fg_color="transparent")
        info.pack(side="left", fill="both", expand=True)
        title = metadata.title if metadata.title else metadata.file_name
        ctk.CTkLabel(info, text=title, anchor="w", 
                    font=ctk.CTkFont(size=11)).pack(fill="x")
        
        # Bouton supprimer
        btn_remove = ctk.CTkButton(item, text="✕", width=25, 
                                  fg_color="transparent", hover_color="#C62828",
                                  command=lambda m=metadata: self.remove_from_playlist(m))
        btn_remove.pack(side="right", padx=5)

    def remove_from_playlist(self, metadata: Metadata):
        """Retire un fichier de la playlist"""
        if metadata in self.playlist:
            self.playlist.remove(metadata)
            self.update_playlist_display()

    def play_playlist(self):
        """Joue toute la playlist"""
        if not self.playlist:
            messagebox.showinfo("Info", "La playlist est vide")
            return
        
        # Désactiver le bouton pendant la lecture
        self.btn_play.configure(state="disabled", text="⏸ Lecture en cours...")
        
        def play_all():
            for idx, metadata in enumerate(self.playlist):
                try:
                    # Mettre à jour l'interface pour montrer quelle chanson joue
                    self.after(0, lambda i=idx, m=metadata: 
                              self.footer_label.configure(
                                  text=f"♫ Lecture: {m.title or m.file_name} ({i+1}/{len(self.playlist)})"
                              ))
                    
                    # Créer l'objet audio approprié
                    if metadata.file_path.lower().endswith(".mp3"):
                        audio = Mp3File(metadata.file_path)
                    else:
                        audio = FlacFile(metadata.file_path)
                    
                    # Jouer le fichier (bloquant jusqu'à la fin)
                    audio.play()
                    
                except Exception as e:
                    print(f"Erreur lors de la lecture de {metadata.file_name}: {e}")
                    continue
            
            # Réactiver le bouton à la fin
            self.after(0, lambda: self.btn_play.configure(state="normal", text="▷ Lire la Playlist"))
            self.after(0, lambda: self.footer_label.configure(text=f"Prêt | Playlist terminée"))
        
        # Lancer la lecture dans un thread pour ne pas bloquer l'interface
        threading.Thread(target=play_all, daemon=True).start()

    def open_playlist(self):
        """Ouvre et charge une playlist XSPF"""
        filename = filedialog.askopenfilename(
            title="Ouvrir une playlist",
            filetypes=[("XSPF Playlist", ".xspf"), ("Tous les fichiers", ".*")]
        )
        
        if not filename:
            return
        
        try:
            import xml.etree.ElementTree as ET
            
            # Parser le fichier XSPF
            tree = ET.parse(filename)
            root = tree.getroot()
            
            # Namespace XSPF
            ns = {'xspf': 'http://xspf.org/ns/0/'}
            
            # Vider la playlist actuelle
            self.playlist.clear()
            
            # Extraire les tracks
            tracklist = root.find('xspf:trackList', ns)
            if tracklist is None:
                messagebox.showerror("Erreur", "Format de playlist invalide")
                return
            
            loaded_count = 0
            for track in tracklist.findall('xspf:track', ns):
                location = track.find('xspf:location', ns)
                if location is not None:
                    # Extraire le chemin du fichier
                    file_path = location.text
                    
                    # Enlever le préfixe file://
                    if file_path.startswith('file://'):
                        file_path = file_path[7:]
                    
                    # Vérifier que le fichier existe
                    if os.path.exists(file_path):
                        # Créer un objet Metadata pour ce fichier
                        metadata = Metadata(file_path)
                        self.playlist.append(metadata)
                        loaded_count += 1
                    else:
                        print(f"Fichier introuvable: {file_path}")
            
            # Mettre à jour l'affichage
            self.update_playlist_display()
            
            messagebox.showinfo("Succès", 
                              f"Playlist chargée avec succès!\n{loaded_count} morceaux ajoutés")
            
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible d'ouvrir la playlist: {e}")

    def save_playlist_dialog(self):
        """Sauvegarde la playlist au format XSPF"""
        if not self.playlist:
            messagebox.showwarning("Attention", "La playlist est vide")
            return
        
        filename = filedialog.asksaveasfilename(
            defaultextension=".xspf",
            filetypes=[("XSPF Playlist", ".xspf"), ("Tous les fichiers", ".*")]
        )
        
        if not filename:
            return
        
        try:
            # Créer un Directory temporaire avec les fichiers de la playlist
            temp_dir = Directory(".")
            temp_dir.files = self.playlist
            temp_dir.generate_xspf_playlist(filename)
            
            messagebox.showinfo("Succès", f"Playlist sauvegardée: {filename}")
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible de sauvegarder: {e}")

    def search_api(self):
        """Recherche les paroles via l'API"""
        if not self.selected_file:
            messagebox.showinfo("Info", "Veuillez sélectionner un fichier d'abord")
            return
        
        query = self.api_entry.get()
        
        def fetch():
            self.selected_file.fetch_lyrics()
            self.after(0, self.display_lyrics)
        
        threading.Thread(target=fetch, daemon=True).start()

    def display_lyrics(self):
        """Affiche les paroles récupérées"""
        if self.selected_file and self.selected_file.lyrics:
            self.lyrics_text.configure(state="normal", text_color="white")
            self.lyrics_text.delete("1.0", "end")
            self.lyrics_text.insert("1.0", self.selected_file.lyrics)
            self.lyrics_text.configure(state="disabled")
            self.api_result_label.configure(text="✓ Paroles trouvées")
        else:
            self.api_result_label.configure(text="✗ Paroles introuvables")


