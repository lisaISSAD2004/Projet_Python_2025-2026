    def download_and_save_cover(self):
        """Télécharge une cover si absente, affiche et demande validation avant sauvegarde"""
        if not self.selected_file:
            messagebox.showinfo("Info", "Veuillez sélectionner un fichier d'abord")
            return

        artist = self.artist_entry.get().strip()
        album = self.album_entry.get().strip()

        if not artist or not album:
            messagebox.showwarning("Attention", "Veuillez renseigner **l'artiste** et **l'album** pour la recherche.")
            return

        # Si une cover existe déjà, on ne fait rien
        if self.selected_file.cover:
             messagebox.showinfo("Info", "Une cover existe déjà dans le fichier")
             return

        # Affichage du statut pendant la recherche
        self.btn_download_cover.configure(text="Recherche en cours...", state="disabled")
        self.update()

        def fetch_in_thread():
            cover_data = fetch_cover_from_itunes(artist, album)
            if not cover_data:
                cover_data = fetch_cover_from_musicbrainz(artist, album)
            
            self.after(0, lambda: self._handle_cover_result(cover_data))

        threading.Thread(target=fetch_in_thread, daemon=True).start()

    def _handle_cover_result(self, cover_data):
        """Gère le résultat de la recherche de cover (appelé depuis le thread)"""
        self.btn_download_cover.configure(text="Télécharger depuis Internet", state="normal")

        if not cover_data:
            messagebox.showwarning("Info", "Aucune cover trouvée en ligne.")
            return

        try:
            # Affichage de la cover dans la fenêtre principale
            img = Image.open(io.BytesIO(cover_data)).resize((230, 230))
            self.cover_image_tk = ctk.CTkImage(light_image=img, dark_image=img, size=(230, 230))
            self.cover_label.configure(image=self.cover_image_tk, text="")

            # --- Popup de validation utilisateur ---
            popup = ctk.CTkToplevel(self)
            popup.title("Valider la couverture")
            popup.geometry("300x350")
            popup.attributes('-topmost', True) # Rendre la popup toujours visible

            ctk.CTkLabel(popup, text="Confirmez-vous cette cover ?").pack(pady=10)
            img_label = ctk.CTkLabel(popup, image=self.cover_image_tk, text="")
            img_label.pack(pady=10)

            def accept():
                # Lancer la sauvegarde dans un autre thread (car cela implique une écriture sur disque)
                threading.Thread(target=lambda: self._save_validated_cover_in_thread(cover_data), 
                                 daemon=True).start()
                popup.destroy()
                self.btn_download_cover.configure(text="Sauvegarde en cours...", state="disabled")

            def refuse():
                popup.destroy()
                self.display_metadata(self.selected_file) # Réaffiche l'état initial (sans cover)
                messagebox.showinfo("Info", "L'opération a été annulée.")

            ctk.CTkButton(popup, text="✓ Oui", fg_color="#4CAF50", command=accept).pack(fill="x", padx=20, pady=5)
            ctk.CTkButton(popup, text="✗ Non", fg_color="#F44336", command=refuse).pack(fill="x", padx=20, pady=5)
            
        except Exception as e:
            print(f"Erreur lors de l'affichage de la cover: {e}")
            messagebox.showerror("Erreur", "Impossible d'afficher la cover téléchargée.")
            self.display_metadata(self.selected_file)

    def _save_validated_cover_in_thread(self, cover_data):
        """Sauvegarde la cover dans le fichier et le dossier (en thread)"""
        try:
            if self.selected_file.file_path.lower().endswith(".mp3"):
                audio_file = Mp3File(self.selected_file.file_path)
            else:
                audio_file = FlacFile(self.selected_file.file_path)
            audio_file.save_cover(cover_data)
            # 2. Sauvegarde dans le dossier de l'album (cover.jpg)
            album_dir = os.path.dirname(self.selected_file.file_path)
            cover_path = os.path.join(album_dir, "cover.jpg")
            with open(cover_path, "wb") as f:
                f.write(cover_data)

            # 3. Mise à jour de l'interface principale (dans le thread UI)
            self.selected_file.extract_tags()
            self.after(0, lambda: self.display_metadata(self.selected_file))
            self.after(0, lambda: messagebox.showinfo("Succès", "Cover sauvegardée avec succès!"))
        except Exception as e:
            err = str(e)
            self.after(0, lambda err=err: messagebox.showerror("Erreur", f"Impossible de sauvegarder la cover: {err}"))

        finally:
            self.after(0, lambda: self.btn_download_cover.configure(text="Télécharger depuis Internet", state="normal"))


    def play_selected_file(self):
        # ... (La fonction reste la même que dans le code initial)
        if not self.selected_file:
            messagebox.showinfo("Info", "Aucun fichier sélectionné")
            return
        
        if self.is_playing and self.current_audio:
            self.stop_playback()
            return
        
        try:
            if self.selected_file.file_path.lower().endswith(".mp3"):
                self.current_audio = Mp3File(self.selected_file.file_path)
            else:
                self.current_audio = FlacFile(self.selected_file.file_path)
            
            self.is_playing = True
            self.btn_play_file.configure(text="⏹ Arrêter", fg_color="#C62828")
            
            def play():
                try:
                    self.current_audio.play()
                except Exception as e:
                    print(f"Erreur de lecture: {e}")
                finally:
                    self.is_playing = False
                    self.after(0, lambda: self.btn_play_file.configure(
                        text="▷ Lire le Morceau", fg_color="#2196F3"))
            
            threading.Thread(target=play, daemon=True).start()
            
        except Exception as e:
            messagebox.showerror("Erreur", f"Impossible de lire le fichier: {e}")
            self.is_playing = False
    
    def stop_playback(self):
        # ... (La fonction reste la même que dans le code initial)
        if self.current_audio:
            try:
                self.current_audio.stop()
            except:
                pass
        self.is_playing = False
        self.btn_play_file.configure(text="▷ Lire le Morceau", fg_color="#2196F3")

    def add_to_playlist(self, metadata: Metadata):
        # ... (La fonction reste la même que dans le code initial)
        if metadata not in self.playlist:
            self.playlist.append(metadata)
            self.update_playlist_display()

    def update_playlist_display(self):
        # ... (La fonction reste la même que dans le code initial)
        if self.playlist:
            self.playlist_empty.grid_forget()
            self.playlist_scroll.grid(row=1, column=0, sticky="nsew", padx=10)
        else:
            self.playlist_scroll.grid_forget()
            self.playlist_empty.grid(row=1, column=0)
        
        for widget in self.playlist_scroll.winfo_children():
            widget.destroy()
        
        for idx, meta in enumerate(self.playlist):
            self.create_playlist_item(meta, idx)
        
        self.playlist_count_label.configure(text=f"{len(self.playlist)} morceaux")

    def create_playlist_item(self, metadata: Metadata, index: int):
        # ... (La fonction reste la même que dans le code initial)
        item = ctk.CTkFrame(self.playlist_scroll, fg_color=("#3b3b3b", "#2b2b2b"))
        item.pack(fill="x", pady=2)
        
        ctk.CTkLabel(item, text=f"{index+1}.", width=30).pack(side="left", padx=5)
        
