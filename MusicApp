def fetch_cover_from_itunes(artist: str, album: str):
    """Recherche et télécharge une cover depuis iTunes"""
    if not artist or not album:
        print("⚠ Artiste et album requis pour la recherche")
        return None
    
    search_term = f"{artist} {album}"
    url = "https://itunes.apple.com/search"
    params = {
        "term": search_term,
        "media": "music",
        "entity": "album",
        "limit": 1
    }
    
    try:
        print(f"🔍 Recherche cover pour : {artist} - {album}")
        response = requests.get(url, params=params, timeout=10)
        
        if response.status_code != 200:
            print(f"✗ Erreur API iTunes : {response.status_code}")
            return None
        
        data = response.json()
        
        if data.get("resultCount", 0) == 0:
            print("✗ Aucun résultat trouvé")
            return None
        
        artwork_url = data["results"][0].get("artworkUrl100")
        if not artwork_url:
            print("✗ Pas d'image disponible")
            return None
        
        # Haute résolution
        artwork_url = artwork_url.replace("100x100", "600x600")
        
        print(f"📥 Téléchargement depuis : {artwork_url}")
        img_response = requests.get(artwork_url, timeout=10)
        
        if img_response.status_code == 200:
            print("✓ Cover téléchargée avec succès")
            return img_response.content
        else:
            print(f"✗ Erreur téléchargement image : {img_response.status_code}")
            return None
            
    except Exception as e:
        print(f"✗ Erreur lors de la recherche : {e}")
        return None

def fetch_cover_from_musicbrainz(artist: str, album: str):
    """Alternative : recherche via MusicBrainz"""
    if not artist or not album:
        return None
    
    try:
        search_url = "https://musicbrainz.org/ws/2/release/"
        params = {
            "query": f'artist:"{artist}" AND release:"{album}"',
            "fmt": "json",
            "limit": 1
        }
        headers = {"User-Agent": "MusicManager/1.0"}
        
        print(f"🔍 Recherche MusicBrainz pour : {artist} - {album}")
        response = requests.get(search_url, params=params, headers=headers, timeout=10)
        
        if response.status_code != 200:
            print(f"✗ Erreur MusicBrainz : {response.status_code}")
            return None
        
        data = response.json()
        
        if not data.get("releases"):
            print("✗ Aucun album trouvé")
            return None
        
        release_id = data["releases"][0]["id"]
        cover_url = f"https://coverartarchive.org/release/{release_id}/front"
        
        print(f"📥 Tentative de téléchargement depuis Cover Art Archive...")
        img_response = requests.get(cover_url, timeout=10)
        
        if img_response.status_code == 200:
            print("✓ Cover téléchargée avec succès")
            return img_response.content
        else:
            print(f"✗ Cover non disponible pour cet album")
            return None
            
    except Exception as e:
        print(f"✗ Erreur MusicBrainz : {e}")
        return None

