    def show_metadata(self, file_path):
        if not file_path:
            return
        
        self.current_file_path = file_path  # ← Garder le fichier actuel
        
        meta = Metadata(file_path)
        self.title_entry.delete(0, "end")
        self.artist_entry.delete(0, "end")
        self.album_entry.delete(0, "end")
        self.year_entry.delete(0, "end")
        self.duration_entry.delete(0, "end")
        self.genre_entry.delete(0, "end")
        self.title_entry.insert(0, meta.title or "")
        self.artist_entry.insert(0, meta.artist or "")
        self.album_entry.insert(0, meta.album or "")
        self.year_entry.insert(0, meta.year or "")
        self.duration_entry.insert(0, meta.duration or "")
        self.genre_entry.insert(0, meta.genre or "")
        
        if meta.cover:
            try:
                meta.cover.seek(0)
                img = Image.open(meta.cover).resize((230, 230))
                self.cover_image_tk = ctk.CTkImage(light_image=img, dark_image=img, size=(230, 230))
                self.cover_label.configure(image=self.cover_image_tk)
                self.cover_label.configure(text="")
            except Exception as e:
                print(f"Erreur chargement cover: {e}")
                import traceback
                traceback.print_exc()
                self.cover_image_tk = None
                self.cover_label.configure(image="")
                self.cover_label.configure(text="Couverture d'album")
        else:
            self.cover_image_tk = None
            self.cover_label.configure(image="")
            self.cover_label.configure(text="Couverture d'album")

        # ============================================================
        # --- EXTRACTION + SAUVEGARDE AUTOMATIQUE DE LA COVER ---
        # ============================================================
        album = meta.album or ""
        artist = meta.artist or ""

        if meta.cover and album and artist:
            try:
                album_dir = os.path.dirname(self.current_file_path)
                cover_path = os.path.join(album_dir, "cover.jpg")
                
                meta.cover.seek(0)
                img = Image.open(meta.cover)
                img.save(cover_path, "JPEG")

                print(f"✓ Cover extraite et sauvegardée : {cover_path}")

            except Exception as e:
                print(f"Erreur extraction cover : {e}")


    def download_and_save_cover(self):
        """Télécharge une cover si absente, affiche et demande validation avant sauvegarde"""
        artist = self.artist_entry.get().strip()
        album = self.album_entry.get().strip()

        if not artist or not album:
            print("⚠ Veuillez renseigner l'artiste et l'album")
            return

        if not hasattr(self, 'current_file_path') or not self.current_file_path:
            print("⚠ Aucun fichier sélectionné")
            return

        meta = Metadata(self.current_file_path)

        # --- SI UNE COVER EXISTE DÉJÀ ---
        if meta.cover:
            print("✓ Une cover existe déjà dans le fichier")
            return self.show_metadata(self.current_file_path)

        # --- Sinon → téléchargement internet ---
        print("🔍 Recherche d'une cover en ligne...")

        cover_data = fetch_cover_from_itunes(artist, album)
        if not cover_data:
            print("🔄 Tentative avec MusicBrainz…")
            cover_data = fetch_cover_from_musicbrainz(artist, album)

        if not cover_data:
            print("✗ Aucune cover trouvée")
            return

        # --- AFFICHAGE pour validation ---
        img = Image.open(io.BytesIO(cover_data)).resize((230, 230))
        self.cover_image_tk = ctk.CTkImage(light_image=img, dark_image=img, size=(230, 230))
        self.cover_label.configure(image=self.cover_image_tk, text="")

        # --- Popup de validation utilisateur ---
        popup = ctk.CTkToplevel(self)
        popup.title("Valider la couverture")
        popup.geometry("300x350")

        ctk.CTkLabel(popup, text="Confirmez-vous cette cover ?").pack(pady=10)
        img_label = ctk.CTkLabel(popup, image=self.cover_image_tk, text="")
        img_label.pack(pady=10)

        def accept():
            self._save_validated_cover(cover_data)
            popup.destroy()

        def refuse():
            popup.destroy()
            print("✗ L'utilisateur a refusé la cover")

        ctk.CTkButton(popup, text="✓ Oui", fg_color="#4CAF50", command=accept).pack(fill="x", padx=20, pady=5)
        ctk.CTkButton(popup, text="✗ Non", fg_color="#F44336", command=refuse).pack(fill="x", padx=20, pady=5)
    def _save_validated_cover(self, cover_data):
        """Sauvegarde la cover dans le fichier et dans le dossier de l'album"""
        meta = Metadata(self.current_file_path)

        # Sauvegarde dans le fichier audio
        if meta.save_cover(cover_data):
            print("✓ Cover sauvegardée dans les métadonnées")

        # Sauvegarde dans le dossier
        album_dir = os.path.dirname(self.current_file_path)
        cover_path = os.path.join(album_dir, "cover.jpg")
        with open(cover_path, "wb") as f:
            f.write(cover_data)

        print(f"✓ Cover enregistrée dans : {cover_path}")

        self.show_metadata(self.current_file_path)
    def save_metadata(self):
        if not hasattr(self, 'current_file_path') or not self.current_file_path:
            print("⚠ Aucun fichier sélectionné")
            return
        meta = Metadata(self.current_file_path)
        meta.title = self.title_entry.get().strip()
        meta.artist = self.artist_entry.get().strip()
        meta.album = self.album_entry.get().strip()
        meta.year = self.year_entry.get().strip()
        meta.genre = self.genre_entry.get().strip()
        success = meta.save_tags()  # ← cette méthode doit exister dans Metadata
        if success:
            print("✓ Tags sauvegardés avec succès !")
            self.show_metadata(self.current_file_path)
        else:
            print("✗ Erreur lors de la sauvegarde des tags")


    def open_folder(self):
        """Ouvre un dossier et scanne les fichiers audio"""
        folder = filedialog.askdirectory()
        if not folder:
            return

        self.directory = Directory(folder)
        self.directory.exploration_dir()
        self.load_files_to_ui()

    def load_files_to_ui(self):
        """Charge les fichiers dans l'explorateur de gauche"""
        for child in self.file_scroll.winfo_children():
            child.destroy()

        if not self.directory or not self.directory.files:
            self.create_file_item("Aucun fichier audio", "Dossier vide")
            return

        for m in self.directory.files:
            title = os.path.basename(m.file_path)
            subtitle = f"{m.artist or 'Artiste inconnu'} - {m.title or 'Titre inconnu'}"
            self.create_file_item(title, subtitle, file_path=m.file_path)

        self.footer_label.configure(text=f"Prêt | {len(self.directory.files)} fichiers trouvés")


